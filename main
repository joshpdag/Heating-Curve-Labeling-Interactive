<script>
"use strict";

var SLOPE={solid:1.0,liquid:1.3,gas:0.7}, PLAT={least:1.0,medium:1.9,most:3.0};
var MAXE=7.0, MINT=-130, MAXT=360;
var SUBS=[
  {key:"water",name:"Water",cvar:"--water",startT:-30,melt:{t:0,e:"medium"},boil:{t:100,e:"medium"},gasEnd:140},
  {key:"alcohol",name:"Rubbing Alcohol",cvar:"--alcohol",startT:-120,melt:{t:-90,e:"most"},boil:{t:80,e:"least"},gasEnd:120},
  {key:"oil",name:"Vegetable Oil",cvar:"--oil",startT:-50,melt:{t:-20,e:"least"},boil:{t:300,e:"most"},gasEnd:340}
];
var FULL={raise:"Thermal energy added raises the temperature",lower:"Thermal energy removed lowers the temperature",
  most:"Most thermal energy needed to change state",medium:"Medium thermal energy needed to change state",least:"Least thermal energy needed to change state"};
var SHORT={solid:"Solid",liquid:"Liquid",gas:"Gas",melting:"Melting",boiling:"Boiling",evaporating:"Evaporating",freezing:"Freezing",condensing:"Condensing",
  raise:"TE raises temp",lower:"TE lowers temp",most:"Most TE for State Change",medium:"Medium TE for State Change",least:"Least TE for State Change"};
function fullText(v){ return (v in FULL)?FULL[v]:(v.charAt(0).toUpperCase()+v.slice(1)); }
function cat(v){ if(v==="solid"||v==="liquid"||v==="gas") return "c-"+v; if(v in FULL) return "c-energy"; return "c-change"; }
function mcat(v){ if(v==="solid"||v==="liquid"||v==="gas") return "mc-"+v; if(v in FULL) return "mc-energy"; return "mc-change"; }

var VBW=980, VBH=600, X0=72, Y0=28, PW=864, PH=486;
function tx(e){ return X0+e/MAXE*PW; }
function ty(T){ return Y0+(MAXT-T)/(MAXT-MINT)*PH; }
var DIR={water:-1,oil:1,alcohol:1};

function segsFor(mode,s){
  var list;
  if(mode==="heat"){
    list=[
      {kind:"slope",what:["solid"],en:["raise"],e:SLOPE.solid,fromT:s.startT,toT:s.melt.t},
      {kind:"plat",what:["melting"],en:[s.melt.e],e:PLAT[s.melt.e],atT:s.melt.t},
      {kind:"slope",what:["liquid"],en:["raise"],e:SLOPE.liquid,fromT:s.melt.t,toT:s.boil.t},
      {kind:"plat",what:["boiling","evaporating"],en:[s.boil.e],e:PLAT[s.boil.e],atT:s.boil.t},
      {kind:"slope",what:["gas"],en:["raise"],e:SLOPE.gas,fromT:s.boil.t,toT:s.gasEnd}
    ];
  } else {
    list=[
      {kind:"slope",what:["gas"],en:["lower"],e:SLOPE.gas,fromT:s.gasEnd,toT:s.boil.t},
      {kind:"plat",what:["condensing"],en:[s.boil.e],e:PLAT[s.boil.e],atT:s.boil.t},
      {kind:"slope",what:["liquid"],en:["lower"],e:SLOPE.liquid,fromT:s.boil.t,toT:s.melt.t},
      {kind:"plat",what:["freezing"],en:[s.melt.e],e:PLAT[s.melt.e],atT:s.melt.t},
      {kind:"slope",what:["solid"],en:["lower"],e:SLOPE.solid,fromT:s.melt.t,toT:s.startT}
    ];
  }
  var x=X0;
  list.forEach(function(sg){
    var x1=x,x2=x+sg.e/MAXE*PW,y1=ty(sg.kind==="plat"?sg.atT:sg.fromT),y2=ty(sg.kind==="plat"?sg.atT:sg.toT);
    sg.x1=x1;sg.y1=y1;sg.x2=x2;sg.y2=y2;sg.mx=(x1+x2)/2;sg.my=(y1+y2)/2;x=x2;
  });
  return list;
}

var cssCache={};
function cssv(n){ if(!(n in cssCache)) cssCache[n]=getComputedStyle(document.documentElement).getPropertyValue(n).trim(); return cssCache[n]; }
function svgEl(t,a){ var e=document.createElementNS("http://www.w3.org/2000/svg",t); for(var k in a) e.setAttribute(k,a[k]); return e; }

var STORE={heat:{},cool:{}};   // STORE[mode][sub-seg] = [values]
var MODE="heat";
var circles=[];                // current-mode circle records

function renderChart(){
  SUBS.forEach(function(s){ s._segs=segsFor(MODE,s); });
  var lg=document.getElementById("curvelegend"); lg.innerHTML="";
  SUBS.forEach(function(s){ var sp=document.createElement("span"); var sw=document.createElement("span"); sw.className="sw"; sw.style.background=cssv(s.cvar); sp.appendChild(sw); sp.appendChild(document.createTextNode(s.name)); sp.style.color=cssv(s.cvar); lg.appendChild(sp); });
  var svg=svgEl("svg",{viewBox:"0 0 "+VBW+" "+VBH,"class":"curve",role:"img","aria-label":(MODE==="heat"?"Heating":"Cooling")+" curves"});
  var axisCol=cssv("--line"), muted=cssv("--muted");
  [-100,0,100,200,300].forEach(function(T){ var y=ty(T);
    svg.appendChild(svgEl("line",{x1:X0,y1:y,x2:X0+PW,y2:y,stroke:axisCol,"stroke-width":1,"stroke-dasharray":"3 6",opacity:.6}));
    var l=svgEl("text",{x:X0-10,y:y+5,"text-anchor":"end","font-size":15,"font-family":"var(--mono)",fill:muted}); l.textContent=T+"°"; svg.appendChild(l);
  });
  svg.appendChild(svgEl("line",{x1:X0,y1:Y0,x2:X0,y2:Y0+PH,stroke:muted,"stroke-width":1.5}));
  svg.appendChild(svgEl("line",{x1:X0,y1:Y0+PH,x2:X0+PW,y2:Y0+PH,stroke:muted,"stroke-width":1.5}));
  var ax=svgEl("text",{x:X0+PW/2,y:Y0+PH+44,"text-anchor":"middle","font-size":16,"font-weight":600,"font-family":"var(--mono)",fill:muted}); ax.textContent=(MODE==="heat"?"Thermal energy added →":"Thermal energy removed →"); svg.appendChild(ax);
  var ay=svgEl("text",{x:20,y:Y0+PH/2,"text-anchor":"middle","font-size":16,"font-weight":600,"font-family":"var(--mono)",fill:muted,transform:"rotate(-90 20 "+(Y0+PH/2)+")"}); ay.textContent="Temperature (°C)"; svg.appendChild(ay);
  SUBS.forEach(function(s){ var col=cssv(s.cvar);
    var pts=[[s._segs[0].x1,s._segs[0].y1]]; s._segs.forEach(function(sg){ pts.push([sg.x2,sg.y2]); });
    svg.appendChild(svgEl("polyline",{points:pts.map(function(p){return p[0].toFixed(1)+","+p[1].toFixed(1);}).join(" "),fill:"none",stroke:col,"stroke-width":4.5,"stroke-linejoin":"round","stroke-linecap":"round"}));
    s._segs.forEach(function(sg,i){
      svg.appendChild(svgEl("circle",{cx:sg.mx,cy:sg.my,r:14,fill:col,stroke:cssv("--panel"),"stroke-width":2.5}));
      var t=svgEl("text",{x:sg.mx,y:sg.my+5,"text-anchor":"middle","font-size":14,"font-weight":600,"font-family":"var(--mono)",fill:"#fff","pointer-events":"none"}); t.textContent=(i+1); svg.appendChild(t);
    });
  });
  document.getElementById("svgwrap").innerHTML=""; document.getElementById("svgwrap").appendChild(svg);

  var ov=document.getElementById("overlay"); ov.innerHTML=""; circles=[];
  SUBS.forEach(function(s){ var dir=DIR[s.key];
    s._segs.forEach(function(sg,i){
      var rec={sub:s.key,seg:i,correct:sg.what.concat(sg.en),mx:sg.mx,my:sg.my,dir:dir};
      var pad=document.createElement("div"); pad.className="droppad";
      pad.style.left=(sg.mx/VBW*100)+"%"; pad.style.top=(sg.my/VBH*100)+"%";
      var dock=document.createElement("div"); dock.className="dock "+(dir<0?"up":"down");
      dock.style.left=(sg.mx/VBW*100)+"%"; dock.style.top=((sg.my+dir*16)/VBH*100)+"%";
      rec.dock=dock;
      [pad,dock].forEach(function(el){
        el.addEventListener("dragover",function(ev){ ev.preventDefault(); pad.classList.add("over"); });
        el.addEventListener("dragleave",function(){ pad.classList.remove("over"); });
        el.addEventListener("drop",function(ev){ ev.preventDefault(); pad.classList.remove("over"); var v=ev.dataTransfer.getData("text/plain"); if(v) addLabel(rec,v); });
      });
      ov.appendChild(pad); ov.appendChild(dock);
      circles.push(rec);
    });
  });
  circles.forEach(function(rec){ renderDock(rec,false); });
}

function keyOf(rec){ return rec.sub+"-"+rec.seg; }
function addLabel(rec,v){
  var arr=STORE[MODE][keyOf(rec)]||(STORE[MODE][keyOf(rec)]=[]);
  if(arr.indexOf(v)<0) arr.push(v);
  renderDock(rec,false);
}
function removeLabel(rec,v){
  var arr=STORE[MODE][keyOf(rec)]; if(!arr) return;
  var k=arr.indexOf(v); if(k>=0) arr.splice(k,1);
  renderDock(rec,false);
}
function renderDock(rec,checked){
  var dock=rec.dock; dock.innerHTML="";
  var arr=STORE[MODE][keyOf(rec)]||[];
  arr.forEach(function(v){
    var c=document.createElement("div"); c.className="minichip "+mcat(v); c.textContent=SHORT[v]; c.title=fullText(v)+" (click to remove)";
    if(checked){ c.classList.add(rec.correct.indexOf(v)>=0?"ok":"bad"); }
    c.addEventListener("click",function(){ removeLabel(rec,v); });
    dock.appendChild(c);
  });
}

function makeBankChip(v){ var c=document.createElement("span"); c.className="chip "+cat(v); c.textContent=fullText(v); c.setAttribute("draggable","true"); c.setAttribute("role","button"); c.setAttribute("tabindex","0");
  c.addEventListener("dragstart",function(ev){ ev.dataTransfer.setData("text/plain",v); ev.dataTransfer.effectAllowed="copy"; }); return c; }
function buildBank(){
  ["solid","liquid","gas"].forEach(function(v){ document.getElementById("bank-states").appendChild(makeBankChip(v)); });
  ["melting","boiling","freezing","condensing"].forEach(function(v){ document.getElementById("bank-changes").appendChild(makeBankChip(v)); });
  ["raise","lower","most","medium","least"].forEach(function(v){ document.getElementById("bank-energy").appendChild(makeBankChip(v)); });
}

function setMode(m){
  MODE=m;
  document.getElementById("tabHeat").classList.toggle("active",m==="heat");
  document.getElementById("tabCool").classList.toggle("active",m==="cool");
  document.getElementById("tabHeat").setAttribute("aria-selected",m==="heat");
  document.getElementById("tabCool").setAttribute("aria-selected",m==="cool");
  document.getElementById("chartTitle").textContent=(m==="heat"?"Heating Curves (thermal energy added)":"Freezing Curves (thermal energy removed)");
  document.getElementById("intro").innerHTML = m==="heat"
    ? "The three substances are <b>heated</b> from cold, gaining thermal energy at a steady rate. <b>Rising</b> = warming up. <b>Flat</b> = changing state. The <b>longer the flat part</b>, the more thermal energy that change needs."
    : "The three substances are <b>cooled</b> from hot, losing thermal energy at a steady rate. <b>Falling</b> = cooling down. <b>Flat</b> = changing state. The <b>longer the flat part</b>, the more thermal energy that change releases.";
  document.getElementById("scorePill").hidden=true;
  renderChart();
}

function checkAll(){
  var total=circles.length*2, correct=0;
  circles.forEach(function(rec){ var arr=STORE[MODE][keyOf(rec)]||[]; arr.forEach(function(v){ if(rec.correct.indexOf(v)>=0) correct++; }); renderDock(rec,true); });
  var pill=document.getElementById("scorePill"); pill.hidden=false; pill.textContent=(MODE==="heat"?"Heating":"Freezing")+" score: "+correct+" / "+total;
}
function resetAll(){ STORE[MODE]={}; circles.forEach(function(rec){ renderDock(rec,false); }); document.getElementById("scorePill").hidden=true; }

function reportMode(mode){
  var lines=["== "+(mode==="heat"?"HEATING":"FREEZING")+" GRAPH =="]; var total=0,correct=0;
  SUBS.forEach(function(s){ var segs=segsFor(mode,s); lines.push(s.name+":");
    segs.forEach(function(sg,i){ var corr=sg.what.concat(sg.en); var arr=STORE[mode][s.key+"-"+i]||[]; total+=2;
      var txt=arr.map(function(v){ var ok=corr.indexOf(v)>=0; if(ok)correct++; return SHORT[v]+"["+(ok?"ok":"check")+"]"; }).join(", ")||"(empty)";
      lines.push("  "+(i+1)+" "+(sg.kind==="plat"?"flat":"rising")+": "+txt);
    });
  });
  lines.push("Subtotal: "+correct+" / "+total); return lines.join("\n");
}
function buildReport(){
  return "Heating & Freezing Curves — Lesson 2.2\nDate: "+new Date().toLocaleDateString()+"\n\n"+reportMode("heat")+"\n\n"+reportMode("cool"); }
function copyResults(){ var t=buildReport(); function done(){ var el=document.getElementById("toast"); el.hidden=false; setTimeout(function(){el.hidden=true;},2600); }
  if(navigator.clipboard&&navigator.clipboard.writeText) navigator.clipboard.writeText(t).then(done,function(){fb(t,done);}); else fb(t,done); }
function fb(t,cb){ var ta=document.createElement("textarea"); ta.value=t; ta.style.position="fixed"; ta.style.opacity="0"; document.body.appendChild(ta); ta.select(); try{document.execCommand("copy");}catch(e){} document.body.removeChild(ta); cb&&cb(); }
function downloadResults(){ var t=buildReport(); var n="heating_freezing_curves";
  var b=new Blob([t],{type:"text/plain"}),u=URL.createObjectURL(b),a=document.createElement("a"); a.href=u; a.download=n+"_curves.txt"; document.body.appendChild(a); a.click(); document.body.removeChild(a); setTimeout(function(){URL.revokeObjectURL(u);},1000); }
function toggleTheme(){ var cur=document.documentElement.getAttribute("data-theme"),mq=window.matchMedia("(prefers-color-scheme: dark)").matches;
  document.documentElement.setAttribute("data-theme", cur?(cur==="dark"?"light":"dark"):(mq?"light":"dark")); cssCache={}; renderChart(); }

buildBank();
document.getElementById("tabHeat").addEventListener("click",function(){ setMode("heat"); });
document.getElementById("tabCool").addEventListener("click",function(){ setMode("cool"); });
document.getElementById("checkBtn").addEventListener("click",checkAll);
document.getElementById("resetBtn").addEventListener("click",resetAll);
document.getElementById("themeBtn").addEventListener("click",toggleTheme);
setMode("heat");

</script>
